NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Redis (TCP) — required for resumable AI streaming (pub/sub). Use a rediss://
# URL from Upstash (Connect → ioredis) or Azure Cache for Redis. NOT the Upstash
# REST URL/token — REST can't do pub/sub.
REDIS_URL=

# Azure OpenAI (recommended) uses the v1 API, which is OpenAI-compatible:
#   OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
#   OPENAI_API_KEY=<key from `az cognitiveservices account keys list`>
#   COPILOT_MODEL=<deployment name, e.g. gpt-5.4-mini>
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
COPILOT_MODEL=gpt-4o-mini

# Google OAuth (Gmail) — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Same Google credentials, consumed by Supabase Auth for "Sign in with Google".
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Base64-encoded 32-byte key used to encrypt stored OAuth tokens at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# HMAC secret for signing AI tool-approval requests. Generate: openssl rand -hex 32
TOOL_APPROVAL_SECRET=
