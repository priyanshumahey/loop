{
  "name": "loop",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "next dev",
    "dev:collab": "bun --watch server/collab.ts",
    "dev:all": "concurrently -k \"bun run dev\" \"bun run dev:collab\"",
    "build": "next build",
    "start": "next start",
    "start:collab": "bun server/collab.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "dev:up": "supabase start",
    "dev:down": "supabase stop",
    "dev:reset": "supabase stop && supabase start",
    "dev:status": "supabase status"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/react": "^4.0.23",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@hocuspocus/provider": "^3.4.4",
    "@hocuspocus/server": "^3.4.4",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/basic-styles": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/floating": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/link": "^53.0.0",
    "@platejs/list": "^53.0.0",
    "@platejs/markdown": "^53.3.3",
    "@platejs/math": "^53.0.0",
    "@platejs/yjs": "^53.0.0",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-toolbar": "^1.1.19",
    "@remixicon/react": "^4.7.0",
    "@slate-yjs/react": "^1.1.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "ai": "^7.0.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "glimm": "^0.3.0",
    "googleapis": "^173.0.0",
    "ioredis": "^5.11.1",
    "isomorphic-dompurify": "^3.18.0",
    "katex": "^0.16.38",
    "liveline": "^0.0.7",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "platejs": "^53.3.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.4",
    "react-textarea-autosize": "^8.5.9",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rrule": "^2.8.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yjs": "^13.6.30",
    "zod": "^4.4.3"
